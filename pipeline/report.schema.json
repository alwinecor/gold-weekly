{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gold Weekly Issue",
  "type": "object",
  "required": ["issue", "window", "overview", "sections", "source_index", "calendar", "analysis", "plain_summary"],
  "properties": {
    "issue": {
      "type": "object",
      "required": ["number", "date", "title"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "overview": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1}
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "title", "groups"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "note": {"type": "string"},
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "items"],
              "properties": {
                "name": {"type": "string"},
                "items": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/sourceCard"}
                }
              }
            }
          }
        }
      }
    },
    "source_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title", "summary", "url"],
        "properties": {
          "date": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "analysis": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string"}
    },
    "plain_summary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "sourceCard": {
      "type": "object",
      "required": ["source_level", "source_name", "published", "title", "summary", "information_type", "url"],
      "properties": {
        "source_level": {"enum": ["primary", "media", "context", "research"]},
        "source_name": {"type": "string", "minLength": 1},
        "published": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string"},
        "caveat": {"type": "string"},
        "information_type": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "related_url": {"type": "string", "pattern": "^https?://"}
      }
    }
  }
}
